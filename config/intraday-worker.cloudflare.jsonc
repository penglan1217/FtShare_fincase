{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ftshare-intraday-collector-penglan1217",
  "main": "../src/background/collector.js",
  "compatibility_date": "2026-11-12",
  "workers_dev": false,
  "observability": { "enabled": true },
  "triggers": {
    "crons": [
      "*/5 1-3,5-7 * * MON-FRI",
      "2 7 * * MON-FRI"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "FTSHARE_CACHE",
      "id": "8e7c76923dd04ac78b043aa84eebdc62"
    }
  ]
}
